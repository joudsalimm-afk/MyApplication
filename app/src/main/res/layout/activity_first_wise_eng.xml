<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="56dp"
      android:background="#B71C1C"
      android:gravity="center_vertical"
      android:paddingStart="16dp"
      android:paddingEnd="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Homework 1"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />
  </LinearLayout>

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="859dp"
      android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="24dp"
          android:gravity="center_vertical"
          android:orientation="horizontal">

        <ImageView
            android:layout_width="69dp"
            android:layout_height="83dp"
            android:src="@drawable/androidlogo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Hello Android!"
            android:textColor="#000000"
            android:textSize="22sp" />
      </LinearLayout>

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="24dp"
          android:gravity="center_vertical"
          android:orientation="horizontal">

        <ImageView
            android:layout_width="73dp"
            android:layout_height="69dp"
            android:src="@drawable/star" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="You are doing great!"
            android:textColor="#000000"
            android:textSize="22sp" />
      </LinearLayout>

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="24dp"
          android:gravity="center_vertical"
          android:orientation="horizontal">

        <ImageView
            android:layout_width="75dp"
            android:layout_height="87dp"
            android:src="@drawable/heart" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Keep going!"
            android:textColor="#000000"
            android:textSize="22sp" />
      </LinearLayout>

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="24dp"
          android:gravity="center_vertical"
          android:orientation="horizontal">

        <ImageView
            android:layout_width="82dp"
            android:layout_height="87dp"
            android:src="@drawable/sun" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Have a nice day!"
            android:textColor="#000000"
            android:textSize="22sp" />
      </LinearLayout>

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="24dp"
          android:gravity="center_vertical"
          android:orientation="horizontal">

        <ImageView
            android:layout_width="84dp"
            android:layout_height="71dp"
            android:src="@drawable/check" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Task Completed"
            android:textColor="#000000"
            android:textSize="22sp" />
      </LinearLayout>

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="24dp"
          android:gravity="center_vertical"
          android:orientation="horizontal">

        <ImageView
            android:layout_width="83dp"
            android:layout_height="76dp"
            android:src="@drawable/smile" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Well done!"
            android:textColor="#000000"
            android:textSize="22sp" />
      </LinearLayout>

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="24dp"
          android:gravity="center_vertical"
          android:orientation="horizontal">

        <ImageView
            android:layout_width="87dp"
            android:layout_height="81dp"
            android:src="@drawable/book" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Keep learning!"
            android:textColor="#000000"
            android:textSize="22sp" />

      </LinearLayout>

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="16dp"
          android:gravity="center_vertical"
          android:orientation="horizontal">

        <ImageView
            android:layout_width="89dp"
            android:layout_height="77dp"
            android:src="@drawable/bell" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Don't forget to practice!"
            android:textColor="#000000"
            android:textSize="22sp" />

      </LinearLayout>

    </LinearLayout>
  </ScrollView>
</LinearLayout>